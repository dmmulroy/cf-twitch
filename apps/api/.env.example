# Local development placeholders only. Never commit .env or copy production tokens here.
# Alchemy reads this file after you copy it to apps/api/.env.
TWITCH_CLIENT_ID=replace-with-test-client-id
TWITCH_CLIENT_SECRET=replace-with-test-client-secret
TWITCH_BROADCASTER_ID=1
TWITCH_BROADCASTER_NAME=TestBroadcaster
TWITCH_EVENTSUB_SECRET=replace-with-a-random-test-webhook-secret
SPOTIFY_CLIENT_ID=replace-with-test-client-id
SPOTIFY_CLIENT_SECRET=replace-with-test-client-secret
OAUTH_SETUP_SECRET=replace-with-a-random-test-setup-secret
ADMIN_SECRET=replace-with-a-random-test-administrator-secret
SONG_REQUEST_REWARD_ID=00000000-0000-4000-8000-000000000001
KEYBOARD_RAFFLE_REWARD_ID=00000000-0000-4000-8000-000000000002

# Optional OTLP HTTP exporter. Leave unset to use Alchemy's default telemetry behavior.
# CF_TWITCH_OTLP_ENDPOINT=https://collector.example.test
# CF_TWITCH_OTLP_TOKEN=replace-with-collector-token

# Cloudflare credentials belong to your Alchemy profile/environment, not this template.
# No production adoption or deployment is enabled by these settings.
